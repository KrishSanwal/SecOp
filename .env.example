# Copy to .env.local and fill in. Never commit .env.local.
# Wearables: Google Health API OAuth client (Cloud console, Testing mode, add crew as test users)
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Optional. Defaults to <origin>/api/health/callback
GOOGLE_HEALTH_REDIRECT=
# Optional. Set to 1 once the irregular rhythm scope is approved for your project
GOOGLE_HEALTH_IRN=
